  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@rolldown/binding-linux-x64-gnu": "^1.2.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
